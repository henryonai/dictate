target/
node_modules/
app/ui/dist/
# Written by tauri-build on every build.
app/src-tauri/gen/
# The permission of each app command (build.rs lists them), also written by tauri-build on every build.
app/src-tauri/permissions/autogenerated/
# What scripts/stage-sidecars.sh puts there for the installers: the programs that go in next to the app (the MCP server, ffmpeg)
# and the libraries that come with them. They are made by the scripts, never committed.
app/src-tauri/binaries/
app/src-tauri/libs/
# And the license files (LICENSE, the notices, the license texts, the LGPL) that it copies from the root of the repository for the release
# overlays to put in the installers.
app/src-tauri/licenses/
# Some global ignore files list macOS's "Icon?" file, which also matches this folder.
!/app/src-tauri/icons/
__pycache__/
