{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dictate",
  "identifier": "io.github.henryonai.dictate",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "Dictate",
        "width": 760,
        "height": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Henry Hoang",
    "copyright": "© 2026 Henry Hoang, MIT",
    "category": "Productivity",
    "shortDescription": "Dictation and meeting notes, with speech recognized on your computer",
    "longDescription": "Dictate writes what you say into any text field and records meetings and calls. It turns recordings and videos into transcripts with the speakers told apart and, when you set up an AI, writes the summary, the decisions and the action items. Speech is recognized on your computer with Whisper.",
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2",
          "libpipewire-0.3-0t64 | libpipewire-0.3-0"
        ],
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav",
          "xdg-desktop-portal",
          "pulseaudio-utils"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
