{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the settings window may do: its own commands, and open web pages.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-set-ai-provider",
    "allow-set-transcribe-preset",
    "allow-set-hotkey",
    "allow-hotkey-status",
    "allow-hotkey-recording",
    "allow-set-secret",
    "allow-check-ai",
    "allow-check-transcribe",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model",
    "allow-models-disk-usage-mb",
    "allow-transcribe-wav",
    "allow-cancel-transcribe",
    "allow-edit-presets",
    "allow-transcribe-presets",
    "allow-open-meetings-folder",
    "allow-permissions-status",
    "allow-request-permission",
    "allow-open-permission-settings",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
